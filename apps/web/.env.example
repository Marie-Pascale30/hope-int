NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
# URL publique du site (canoniques, hreflang, Open Graph, sitemap) - inlinee au build
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# URL de l'API pour le rendu serveur (repli sur NEXT_PUBLIC_API_BASE_URL) ; en Docker : http://backend:5000/api
API_INTERNAL_URL=
# Reseaux sociaux du pied de page (URL https, inlinees au build ; vide = non affiche)
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://web.facebook.com/Hopeinternationalcameroon
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
# Mentions legales (/mentions-legales) - variables serveur lues au rendu (build et regeneration) ;
# une valeur vide masque la ligne correspondante.
# Numero d'enregistrement / de declaration de l'association (ex. recepisse de declaration)
LEGAL_REGISTRATION_NUMBER=
# Direction de la publication (par defaut : la presidente de l'association, issue de GET /meta)
LEGAL_PUBLICATION_DIRECTOR=
# Hebergeur du site : la section "Hebergement" n'est affichee que si LEGAL_HOST_NAME est renseigne
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
# Telephone ou URL de contact de l'hebergeur
LEGAL_HOST_CONTACT=
# Durees de conservation affichees dans /confidentialite : a aligner sur la configuration de l'API
# si elle differe des valeurs par defaut (30 jours, 12 mois, 24 mois, 10 ans)
# RETENTION_OUTBOX_DAYS=30
# RETENTION_LOGS_MONTHS=12
# RETENTION_REFUSED_APPLICATIONS_MONTHS=24
# ACCOUNTING_RETENTION_YEARS=10
