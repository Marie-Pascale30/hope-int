{
  "name": "@hope/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "eslint .",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=85 --test-coverage-exclude=\"test/**\" \"test/*.test.js\"",
    "seed:demo": "node scripts/seed-demo.js",
    "content:import": "node scripts/import-content.js",
    "admin:create": "node scripts/create-admin.js",
    "docs:api": "redocly lint openapi.yaml && redocly build-docs openapi.yaml -o docs/index.html"
  },
  "type": "commonjs",
  "dependencies": {
    "@hope/shared": "*",
    "@sentry/node": "^11.6.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.20.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^2.62.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.0"
  }
}
