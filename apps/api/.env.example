PORT=5000
# Hors production, un port occupe bascule sur le suivant libre ; false pour l'interdire
PORT_FALLBACK=true
NODE_ENV=development

# URL publique du frontend (liens dans les emails, retour de paiement Mobile Money)
FRONTEND_URL=http://localhost:3001
# URL publique de l'API (lien de telechargement des recus dans les emails)
API_PUBLIC_URL=http://localhost:5000/api
CORS_ORIGIN=http://localhost:3001
# Derriere un reverse proxy (nginx...), nombre de proxies a faire confiance : 1
TRUST_PROXY=

# Utilisateur applicatif cree par docker compose (MYSQL_USER / MYSQL_PASSWORD du .env racine)
DB_HOST=localhost
DB_USER=hope
DB_PASSWORD=change_me
DB_NAME=hope_platform
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
# Migrations appliquees au demarrage ; false si elles sont lancees a part (npm run migrate)
MIGRATE_ON_START=true

# Au moins 32 caracteres aleatoires (obligatoire en production)
JWT_SECRET=change_me

# Cookie de session (httpOnly). Par defaut : SameSite=Lax, Secure en production.
# Site et API sur des domaines differents (pas seulement des sous-domaines) : COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax
# Forcer Secure (true/false) ; vide = automatique
COOKIE_SECURE=
# Partager le cookie entre sous-domaines, ex. .hope.org ; vide = domaine de l'API
COOKIE_DOMAIN=

# Paiement par carte (EUR) - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
# Obligatoire en production (stripe listen / endpoint de webhook) : whsec_...
STRIPE_WEBHOOK_SECRET=

# Mobile Money Orange / MTN (XAF). Prestataire utilise : MOBILE_MONEY_PROVIDER (notchpay | flutterwave),
# sinon le premier configure (Notch Pay en priorite).
MOBILE_MONEY_PROVIDER=
# Notch Pay - https://business.notchpay.co > Settings > API Keys
NOTCHPAY_PUBLIC_KEY=pk_test.xxxxxxxxxxxxxxxx
# Cle privee (sk_test.... / sk....), facultative, envoyee en X-Grant
NOTCHPAY_PRIVATE_KEY=
# Cle de hachage des webhooks (meme ecran) ; endpoint : POST {API}/payment/notchpay/webhook
NOTCHPAY_WEBHOOK_HASH=

# Flutterwave - https://app.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx-X
# Valeur "Secret hash" definie dans Flutterwave > Webhooks
FLUTTERWAVE_WEBHOOK_HASH=

# Emails (identifiants, recus, reinitialisation). Sans SMTP, les emails s'affichent dans la console en dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HOPE International <no-reply@hope-international.org>"
# Delai max (ms) de connexion / accueil / inactivite SMTP
SMTP_TIMEOUT_MS=10000
# File d'envoi persistante (table email_outbox) : worker interne a l'API, intervalle en ms.
# EMAIL_OUTBOX_WORKER=false pour ne pas lancer le worker dans cette instance.
EMAIL_OUTBOX_INTERVAL_MS=15000
EMAIL_OUTBOX_WORKER=true

# Rapprochement planifie des paiements (relecture des dons en attente chez les prestataires).
# Intervalle en ms (defaut 20 min) ; RECONCILE_WORKER=false pour ne pas le lancer dans cette instance.
# Verrou MySQL : une seule instance l'execute a la fois.
RECONCILE_INTERVAL_MS=1200000
RECONCILE_WORKER=true

# Supervision : GET /api/health/details accessible avec l'en-tete X-Health-Token (sinon session
# avec la permission IT). Laisser vide pour n'autoriser que les sessions.
HEALTH_TOKEN=

# Cache memoire des chiffres d'impact publics (GET /api/impact), en ms ; 0 pour le desactiver.
IMPACT_CACHE_MS=60000

# Informations de l'association (recus de don, page contact)
ORG_NAME=HOPE International
ORG_ADDRESS=Douala, Cameroun
ORG_REGISTRATION=
ORG_SIGNATORY=La Direction générale
ORG_CONTACT_EMAIL=contact@hope-international.org
ORG_CONTACT_PHONE=
RECEIPT_FISCAL_MENTION=
# Fuseau des recus (annee de numerotation, dates imprimees), independant de l'horloge du serveur
RECEIPT_TIMEZONE=Africa/Douala

API_RATE_LIMIT_MAX=5000
BYPASS_LOCAL_RATE_LIMIT=true

# --- Engagement : consentements, RGPD, double authentification, campagnes ---
# Cle des liens signes (preferences, desinscription, newsletter) : 32 caracteres minimum.
# A generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (vide : derivee de JWT_SECRET, qui ne doit alors plus changer)
ENGAGEMENT_TOKEN_SECRET=
# Validite des liens de preferences (jours)
PREFERENCES_LINK_TTL_DAYS=730
# Version des textes de consentement affiches (a changer a chaque modification des textes)
CONSENT_TEXT_VERSION=2026-10-v1
# Chiffrement des secrets TOTP (AES-256-GCM) : 32 octets en hexadecimal, OBLIGATOIRE en production.
# A generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=
# Permissions rendant la double authentification obligatoire (vide : jamais obligatoire)
MFA_REQUIRED_PERMISSIONS=manage_finance,manage_user_roles,delete_users,manage_it
# Nom affiche dans l'application d'authentification (defaut : ORG_NAME)
MFA_ISSUER=
# Durees de conservation
ACCOUNTING_RETENTION_YEARS=10
RETENTION_OUTBOX_DAYS=30
RETENTION_LOGS_MONTHS=12
RETENTION_REFUSED_APPLICATIONS_MONTHS=24
# Purge quotidienne (false pour la desactiver sur une instance)
RETENTION_WORKER=true
# CRM : seuil "grand donateur" (EUR, XAF converti)
MAJOR_DONOR_THRESHOLD_EUR=1000
# Campagnes : destinataires mis en file par passage, frequence du worker, false pour le desactiver
CAMPAIGN_BATCH_SIZE=200
CAMPAIGN_INTERVAL_MS=60000
CAMPAIGN_WORKER=true

# --- Taches planifiees des modules (chacune desactivable avec <NOM>_WORKER=false) ---
# Relance des paiements abandonnes (1re relance apres FIRST_HOURS, 2e apres SECOND_HOURS)
DONATION_REMINDER_WORKER=true
DONATION_REMINDER_INTERVAL_MS=900000
DONATION_REMINDER_FIRST_HOURS=2
DONATION_REMINDER_SECOND_HOURS=24
# Rappels mensuels des engagements Mobile Money
PLEDGE_REMINDER_WORKER=true
PLEDGE_REMINDER_INTERVAL_MS=3600000
# Envoi des recapitulatifs fiscaux annuels (janvier), par lots
ANNUAL_SUMMARY_WORKER=true
ANNUAL_SUMMARY_INTERVAL_MS=600000
ANNUAL_SUMMARY_BATCH=25
# Rappel la veille des evenements (delai en heures avant le debut)
EVENT_REMINDER_WORKER=true
EVENT_REMINDER_INTERVAL_MS=900000
EVENT_REMINDER_LEAD_HOURS=24

# --- Transparence ---
# Justificatifs prives (depenses, dons hors ligne) : dossier jamais servi publiquement
PRIVATE_UPLOADS_DIR=private-uploads
# Cache des donnees publiques de transparence (ms ; 0 = sans cache)
TRANSPARENCY_CACHE_MS=300000
