# Copier en infra/backup/backup.env (ignore par git) pour le service compose `backup`.
# Les identifiants MySQL viennent du .env racine (MYSQL_USER / MYSQL_PASSWORD).

# Planification cron (UTC) et retention locale
BACKUP_CRON=30 2 * * *
KEEP_DAILY=7
KEEP_WEEKLY=4
# true : une sauvegarde immediate au demarrage du service (test)
BACKUP_RUN_NOW=false

# Chiffrement (recommande des que les sauvegardes quittent le serveur). A conserver hors du serveur :
# sans elle, les sauvegardes sont irrecuperables.
BACKUP_PASSPHRASE=

# Stockage S3-compatible (optionnel) : AWS, Scaleway, OVH, Backblaze B2, MinIO...
S3_BUCKET=
S3_PREFIX=hope-backups
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
