# Variables de docker compose (copier en .env a la racine). Les secrets de l'API sont dans apps/api/.env.

# Mots de passe MySQL : appliques a la creation du volume mysql_data
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=hope
MYSQL_PASSWORD=change_me

# Cle publique Stripe (pk_test_... / pk_live_...), inlinee dans le build du site
STRIPE_PUBLISHABLE_KEY=
