{
  "name": "hope-international",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w @hope/api\" \"npm run dev -w @hope/web\"",
    "dev:api": "npm run dev -w @hope/api",
    "dev:web": "npm run dev -w @hope/web",
    "build": "npm run build -w @hope/web",
    "start:api": "npm run start -w @hope/api",
    "start:web": "npm run start -w @hope/web",
    "lint": "npm run lint -w @hope/web",
    "seed": "npm run seed -w @hope/api --",
    "db": "docker compose up -d mysql phpmyadmin"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
