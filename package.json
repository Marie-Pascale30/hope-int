{
  "name": "hope-international",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev -w @hope/api",
    "dev:web": "node scripts/dev.js web",
    "build": "npm run build -w @hope/web",
    "start:api": "npm run start -w @hope/api",
    "start:web": "npm run start -w @hope/web",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm run seed -w @hope/api --",
    "db": "docker compose --profile dev up -d mysql phpmyadmin",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate -w @hope/api --",
    "test:e2e": "npm run test:e2e -w @hope/web",
    "test:coverage": "npm run test:coverage -w @hope/api",
    "seed:demo": "npm run seed:demo -w @hope/api --",
    "content:import": "npm run content:import -w @hope/api --",
    "admin:create": "npm run admin:create -w @hope/api --",
    "docs:api": "npm run docs:api -w @hope/api",
    "check": "npm run check:i18n -w @hope/web && npm run check:contrast -w @hope/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
